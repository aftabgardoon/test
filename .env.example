# =============================================================
# Multi-Channel Sync Bot - environment configuration
# Copy this file to `.env` and fill in the values.
# =============================================================

# --- General ---
APP_NAME=Multi-Channel Sync Bot
DEBUG=false
ENVIRONMENT=development

# --- Database ---
# PostgreSQL (production / docker):
# DATABASE_URL=postgresql+asyncpg://syncbot:syncbot@postgres:5432/syncbot
# SQLite (local dev / tests):
DATABASE_URL=sqlite+aiosqlite:///./syncbot.db

# --- Redis queue ---
REDIS_URL=redis://redis:6379/0
# When false, an in-memory queue is used (useful for local dev / tests).
QUEUE_ENABLED=false

# --- Security ---
# Fernet key (base64 url-safe, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a deterministic key is derived from WEBHOOK_SECRET (DEV ONLY).
FERNET_KEY=
# Secret used as fallback to derive the Fernet key when FERNET_KEY is empty.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Bot Manager (the bot users talk to; Bale or Telegram-like) ---
MANAGER_BOT_TOKEN=
MANAGER_BOT_PLATFORM=bale

# --- Source listener bots (used by long polling) ---
# The bot must be admin in every source channel you want to sync.
BALE_BOT_TOKEN=
RUBIKA_BOT_TOKEN=
EITAA_BOT_TOKEN=

# --- Long polling ---
POLLING_ENABLED=true
POLLING_TIMEOUT=15
POLLING_RETRY_DELAY=5.0
POLLING_INTERVAL=2.0

# --- Concurrency ---
# Max messages delivered in parallel by the worker (per-user tasks).
WORKER_CONCURRENCY=20

# --- Rate limiting / retry ---
# Max messages per second per adapter (Bale recommends ~30 msg/s).
RATE_LIMIT_RPS=30
RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=1.5
